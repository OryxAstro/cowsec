#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    install -d -m 0700 /var/lib/cowsec /etc/cowsec
    rm -f /var/lib/cowsec/uninstalled   # installed again after an uninstall: start afresh
    # a hand-installed CowSec's unit in /etc/systemd/system would override the package's
    /usr/sbin/cowsec-setup migrate-legacy || echo "cowsec: could not migrate the earlier hand-installed CowSec; see 'cowsec-setup migrate-legacy'" >&2
    # mail WAF: switch CowSec's AppSec engine from CrowdSec's catch-all default (kept if CrowdSec rejects it)
    /usr/sbin/cowsec-setup appsec-curate --if-default || echo "cowsec: mail WAF not applied; see 'cowsec-setup appsec-curate'" >&2
    # up to 0.3.9 the edge put mailcow's web server on 8081, which clashes with mailcow's internal lookups
    /usr/sbin/cowsec-setup fix-mailcow-port || echo "cowsec: could not move mailcow's web port; see 'cowsec-setup fix-mailcow-port'" >&2
    # up to 0.4.2 the IPv6 check always said no, so the edge never listened on IPv6
    /usr/sbin/cowsec-setup fix-ipv6-listen || echo "cowsec: could not add IPv6 to the edge; see 'cowsec-setup fix-ipv6-listen'" >&2
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable cowsec >/dev/null 2>&1 || true
    systemctl restart cowsec >/dev/null 2>&1 || true
    if [ ! -f /var/lib/cowsec/setup-complete ]; then
        i=0
        while [ ! -s /var/lib/cowsec/setup-token ] && [ $i -lt 20 ]; do sleep 0.5; i=$((i+1)); done
        /usr/sbin/cowsec-setup status || true
    fi
fi
exit 0
