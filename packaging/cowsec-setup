#!/usr/bin/env python3
"""cowsec-setup: set up and manage CowSec from the terminal.

  cowsec-setup                 show the setup wizard address and token (or the console status)
  cowsec-setup check           run the pre-flight checks
  cowsec-setup install --config FILE
                               headless install from a JSON config (same format as the wizard)
  cowsec-setup access local|lan|wan|tunnel [--hostname NAME] [--tunnel-token TOKEN]
                               change how the console is reached
  cowsec-setup mailcow-api     let the console manage mailcow (domains, mailboxes, queue...) via mailcow's API
  cowsec-setup reset-wizard    re-open the browser setup wizard with a new token
  cowsec-setup revert-edge     stop the OpenResty edge and give ports 80/443 back to mailcow
  cowsec-setup restore-mailcow put mailcow's settings and certificates back as they were before CowSec
  cowsec-setup appsec-curate   rebuild the mail WAF (mail-stack rules block, the rest watch for scanners)
  cowsec-setup fix-mailcow-port  move mailcow's local web port off 8081 (installs before 0.3.10)
  cowsec-setup uninstall      hand mailcow back to its own settings and remove everything CowSec added
  cowsec-setup migrate-legacy  take over a hand-installed CowSec (run automatically by the package)
"""
import argparse, glob, json, os, shutil, socket, subprocess, sys

sys.path.insert(0, "/usr/lib/cowsec")
import setup_engine as se  # noqa: E402

STATE = se.STATE_DIR
B, G, Y, R, D, N = "\033[1m", "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[0m"


def need_root():
    if os.geteuid() != 0:
        sys.exit("cowsec-setup must run as root (sudo cowsec-setup ...)")


def local_ips():
    """IPv4 addresses on real interfaces (not Docker bridges or veth pairs)."""
    rc, out = se.run(["ip", "-4", "-o", "addr", "show", "scope", "global"])
    ips = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) > 3 and not parts[1].startswith(("docker", "br-", "veth", "cni", "virbr")):
            ips.append(parts[3].split("/")[0])
    return ips or ["<server-ip>"]


def status():
    if not os.path.exists(os.path.join(STATE, "setup-complete")):
        tok = open(os.path.join(STATE, "setup-token")).read().strip() if os.path.exists(os.path.join(STATE, "setup-token")) else None
        fp = open(os.path.join(STATE, "setup-fingerprint")).read().strip() if os.path.exists(os.path.join(STATE, "setup-fingerprint")) else None
        print(f"\n  {B}🐄 CowSec setup{N}\n")
        if not tok:
            print(f"  {Y}The setup wizard is not running yet.{N} Start it with: systemctl restart cowsec\n")
            return
        print("  Open the setup wizard in your browser:\n")
        for ip in local_ips():
            print(f"    {G}https://{ip}:9443{N}")
        print(f"\n  Setup token:   {B}{tok}{N}")
        if fp:
            print(f"  {D}Certificate SHA-256 (self-signed, check it matches your browser):{N}\n  {D}{':'.join(fp[i:i+2] for i in range(0, len(fp), 2))}{N}")
        print(f"\n  {D}Port 9443 closes for good once setup is finished.{N}\n")
        return
    cfg = json.load(open(os.path.join(STATE, "setup.json"))) if os.path.exists(os.path.join(STATE, "setup.json")) else {}
    acc = cfg.get("access", {})
    rc, active = se.run(["systemctl", "is-active", "cowsec"])
    print(f"\n  {B}🐄 CowSec{N}  service: {G if active == 'active' else R}{active}{N}")
    mode = acc.get("mode", "local")
    where = {"lan": f"https://{acc.get('hostname')} (local network)", "wan": f"https://{acc.get('hostname')} (internet)",
             "tunnel": "your Cloudflare Tunnel hostname", "local": "ssh -L 8090:127.0.0.1:8090 <server>, then http://localhost:8090"}[mode]
    print(f"  console:  {where}\n  accounts: sudo cowsec auth status\n")


def check():
    res = se.preflight()
    icon = {"ok": f"{G}✔{N}", "warn": f"{Y}!{N}", "fail": f"{R}✘{N}", "info": f"{D}·{N}"}
    for c in res["checks"]:
        print(f"  {icon[c['status']]} {c['title']}" + (f"  {D}{c['detail']}{N}" if c["detail"] else ""))
    print(f"\n  {G}Ready to install.{N}\n" if res["ok"] else f"\n  {R}Fix the failed checks first.{N}\n")
    return 0 if res["ok"] else 1


def install(path):
    cfg = se.validate_config(json.load(open(path)))
    r = se.Runner(echo=True)
    se.install(cfg, r)
    print(f"\n{G}Installed.{N} Create an account with: sudo cowsec auth local-admin set <name>")
    open(os.path.join(STATE, "setup-complete"), "w").write("cli\n")
    for f in ("setup-token", "setup-fingerprint"):
        if os.path.exists(os.path.join(STATE, f)):
            os.remove(os.path.join(STATE, f))
    subprocess.run(["systemctl", "restart", "cowsec"])


def access(mode, hostname, token):
    saved = json.load(open(os.path.join(STATE, "setup.json")))
    saved["access"] = {"mode": mode}
    if hostname:
        saved["access"]["hostname"] = hostname
    if token:
        saved["access"]["tunnelToken"] = token
    if saved.get("certs", {}).get("mode") == "dns01":
        saved["certs"]["credentials"] = se.read_kv(se.ETC_DIR + "/dns.env")
        saved["certs"].update({k: v for k, v in json.load(open(se.ETC_DIR + "/certs.json")).items()})
    c = se.validate_config(saved)
    r = se.Runner(echo=True)
    ctx = {"mailcow": se.mailcow_info(), "ipv6": se.ipv6_enabled()}
    if c["certs"]["mode"] == "dns01":
        se.step_certs(c, r, ctx, force_deploy=False)
    se.step_access(c, r, ctx)
    json.dump(se.public_config(c), open(os.path.join(STATE, "setup.json"), "w"), indent=2)
    subprocess.run(["systemctl", "restart", "cowsec"])
    print(f"{G}Console access is now: {mode}{N}")


def mailcow_api():
    r = se.Runner(echo=True)
    ctx = {"mailcow": se.mailcow_info(), "ipv6": se.ipv6_enabled()}
    if not ctx["mailcow"]["found"]:
        sys.exit("mailcow not found")
    se.step_mailcow_api({"components": {}}, r, ctx)
    subprocess.run(["systemctl", "restart", "cowsec"])
    print(f"{G}The console can now manage mailcow.{N}")


def restore_mailcow(src, yes):
    path = src or (open(se.SNAPSHOT_POINTER).read().strip() if os.path.exists(se.SNAPSHOT_POINTER) else "")
    if not path:
        sys.exit("No pre-install snapshot recorded. Snapshots are in %s; pass one with --from." % se.SNAPSHOT_DIR)
    print("This puts mailcow's settings and certificates back exactly as they were before CowSec:")
    print("  snapshot: %s" % path)
    print("  - stops the OpenResty edge, so mailcow's own web server takes ports 80/443 again")
    print("  - restores mailcow.conf, extra.cf, docker-compose.override.yml and data/assets/ssl")
    print("  - restarts mailcow (mail is offline for a minute or two)")
    print("  CrowdSec and its firewall bouncer keep running; remove them with apt if you want them gone.")
    if not yes and input("Type RESTORE to continue: ").strip() != "RESTORE":
        sys.exit("Cancelled.")
    se.restore_mailcow(se.Runner(echo=True), path)
    print(f"{G}mailcow is back on its original settings.{N}")


def appsec_curate(if_default):
    res = se.appsec_curate(se.Runner(echo=True), only_if_default=if_default)
    if res.get("skipped"):
        print("mail WAF: %s" % res["skipped"])
    else:
        c = res["counts"]
        print(f"{G}mail WAF: {c['block']} rules block, {c['watch']} watch for scanners, {c['off']} off.{N}")


def uninstall(yes):
    if os.path.exists(se.UNINSTALLED):
        print("CowSec is already uninstalled from this server. Remove the package with: sudo apt purge cowsec")
        return
    print(f"{B}Uninstall CowSec{N}")
    print("  - mailcow gets its own settings back: web ports, certificates (its own Let's Encrypt) and API key,")
    print("    as they were before CowSec, and its netfilter enforces its own bans again")
    print("  - an earlier hand-built OpenResty setup that CowSec took over is put back")
    print("  - CowSec's timers, certificates, edge config and CrowdSec extras are removed")
    print("  - mailcow restarts (mail is offline for a minute or two); CrowdSec keeps protecting the server")
    if not yes and input("Type UNINSTALL to continue: ").strip() != "UNINSTALL":
        sys.exit("Cancelled.")
    res = se.uninstall(se.Runner(echo=True))
    print(f"{G}CowSec is detached; mailcow runs on its own.{N}")
    if res["kept_edge"]:
        print("  Your earlier OpenResty setup is back in front of mailcow.")
    print("  Remove the package with: sudo apt purge cowsec")
    print("  CrowdSec, its bouncers, OpenResty and cloudflared stay installed; remove them with apt if you want.")


def fix_mailcow_port():
    res = se.fix_mailcow_http_port(se.Runner(echo=True))
    if not res["changed"]:
        print("mailcow web port: %s" % res["reason"])
    elif res["lookup_ok"]:
        print(f"{G}mailcow's web server moved to port {se.EDGE_MAILCOW_HTTP}; postfix's forwarding-host lookups work again.{N}")
    else:
        print(f"{Y}mailcow's web server moved to port {se.EDGE_MAILCOW_HTTP}, but postfix's forwarding-host lookup still fails.{N}")


def reset_wizard():
    for f in ("setup-complete", "setup-token"):
        p = os.path.join(STATE, f)
        if os.path.exists(p):
            os.remove(p)
    subprocess.run(["systemctl", "restart", "cowsec"])
    import time
    time.sleep(2)
    status()


def revert_edge():
    mc = se.find_mailcow()
    conf = os.path.join(mc, "mailcow.conf")
    baks = sorted(glob.glob(conf + ".cowsec-bak-*"))
    if not baks:
        sys.exit("no mailcow.conf backup from CowSec found")
    r = se.Runner(echo=True)
    r.sh(["systemctl", "disable", "--now", "openresty"], check=False)
    shutil.copy2(conf, conf + ".before-revert")
    shutil.copy2(baks[0], conf)
    r.log("restored %s (the copy taken before CowSec first changed it)" % baks[0])
    se.compose(mc, ["up", "-d"], r)
    for f in (se.NGX + "/sites/cowsec-mailcow.conf", se.NGX + "/sites/cowsec-console.conf"):
        if os.path.exists(f):
            os.rename(f, f + ".disabled")
    print(f"{G}mailcow serves ports 80/443 itself again.{N} CrowdSec and the firewall bouncer keep running.")


def migrate_legacy():
    if se.migrate_legacy(se.Runner(echo=True)):
        print(f"{G}Hand-installed CowSec moved aside;{N} accounts, 2FA and the ban policy are kept.")


def main():
    p = argparse.ArgumentParser(description="Set up and manage CowSec.")
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("check")
    i = sub.add_parser("install"); i.add_argument("--config", required=True)
    a = sub.add_parser("access"); a.add_argument("mode", choices=["local", "lan", "wan", "tunnel"])
    a.add_argument("--hostname"); a.add_argument("--tunnel-token")
    sub.add_parser("reset-wizard"); sub.add_parser("revert-edge")
    rm = sub.add_parser("restore-mailcow"); rm.add_argument("--from", dest="src"); rm.add_argument("--yes", action="store_true")
    ac = sub.add_parser("appsec-curate"); ac.add_argument("--if-default", action="store_true"); sub.add_parser("status"); sub.add_parser("mailcow-api"); sub.add_parser("migrate-legacy"); sub.add_parser("fix-mailcow-port")
    un = sub.add_parser("uninstall"); un.add_argument("--yes", action="store_true")
    args = p.parse_args()
    need_root()
    try:
        if args.cmd in (None, "status"):
            status()
        elif args.cmd == "check":
            sys.exit(check())
        elif args.cmd == "install":
            install(args.config)
        elif args.cmd == "access":
            access(args.mode, args.hostname, args.tunnel_token)
        elif args.cmd == "mailcow-api":
            mailcow_api()
        elif args.cmd == "reset-wizard":
            reset_wizard()
        elif args.cmd == "revert-edge":
            revert_edge()
        elif args.cmd == "restore-mailcow":
            restore_mailcow(args.src, args.yes)
        elif args.cmd == "appsec-curate":
            appsec_curate(args.if_default)
        elif args.cmd == "migrate-legacy":
            migrate_legacy()
        elif args.cmd == "fix-mailcow-port":
            fix_mailcow_port()
        elif args.cmd == "uninstall":
            uninstall(args.yes)
    except se.StepError as e:
        sys.exit(f"{R}error:{N} {e}")


if __name__ == "__main__":
    main()
