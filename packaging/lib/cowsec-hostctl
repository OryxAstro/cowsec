def job_state(name):
    try:
        st = json.load(open(os.path.join(JOB_DIR, name + ".json")))
    except Exception:
        return {"name": name, "state": "never"}
    rc, out, _ = run(["systemctl", "is-active", "cowsec-job-" + name])
    if out.strip() in ("active", "activating") and st.get("state") == "running":
        st["state"] = "running"
    elif st.get("state") == "running":
        st["state"] = "failed"  # unit gone without writing a result
    try:
        st["log"] = open(os.path.join(JOB_DIR, name + ".log")).read()[-6000:]
    except Exception:
        st["log"] = ""
    st["name"] = name
    return st

def job_start(name):
    if job_state(name).get("state") == "running":
        raise RuntimeError("%s is already running" % name)
    os.makedirs(JOB_DIR, mode=0o700, exist_ok=True)
    rc, out, err = run(["systemd-run", "--unit=cowsec-job-" + name, "--collect", "--quiet",
                        "--setenv=SSH_ORIGINAL_COMMAND=job-exec " + name, "--setenv=COWSEC_STATE_DIR=" + STATE_DIR,
                        "--setenv=SSH_CLIENT=" + os.environ.get("SSH_CLIENT", "cowsec 0 0"), os.path.abspath(sys.argv[0])])
    if rc != 0:
        raise RuntimeError("could not start job: " + (err or out).strip())
    return {"started": name}

def setup_install(logp, stp, started):
    """Runs the setup wizard's install with per-step progress. Secrets in the pending
    config go to root-only files under /etc/cowsec; the pending file is always deleted."""
    pending = os.path.join(STATE_DIR, "setup.pending.json")
    r = se.Runner(logp)
    steps = []
    def save(state, extra=None):
        d = {"state": state, "started": started, "steps": steps}
        d.update(extra or {})
        json.dump(d, open(stp, "w"))
    try:
        c = se.validate_config(json.load(open(pending)))
    except Exception as e:
        r.log("invalid setup configuration: %s" % e)
        save("failed", {"rc": 2, "error": str(e), "finished": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
        return 2
    finally:
        if os.path.exists(pending):
            os.remove(pending)
    steps.extend({"id": p["id"], "title": p["title"], "state": "pending"} for p in se.plan(c))
    save("running")
    def progress(sid, state):
        for st in steps:
            if st["id"] == sid:
                st["state"] = state
        save("running")
    try:
        se.install(c, r, progress)
    except Exception as e:
        save("failed", {"rc": 1, "error": str(e), "finished": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
        return 1
    save("ok", {"rc": 0, "finished": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    return 0

def staged(logp, stp, started, fn):
    """Runs a staged job, saving per-step progress (and live extras) for the UI."""
    r = se.Runner(logp)
    job = {"state": "running", "started": started, "steps": [], "extra": {}}
    def save():
        tmp = stp + ".tmp"
        json.dump(job, open(tmp, "w"))
        os.replace(tmp, stp)
    def progress(sid, state, plan=None, **extra):
        if state == "plan":
            job["steps"] = [{"id": p["id"], "title": p["title"], "state": "pending"} for p in plan]
        else:
            for st in job["steps"]:
                if st["id"] == sid:
                    st["state"] = state
                    if state == "running" and "began" not in st:
                        st["began"] = time.time()
                    if state in ("ok", "failed"):
                        st["ended"] = time.time()
            job["extra"].update(extra)
        save()
    save()
    try:
        fn(r, progress)
        job["state"], rc = "ok", 0
    except Exception as e:
        for st in job["steps"]:
            if st["state"] == "running":
                st["state"], st["ended"] = "failed", time.time()
        job["state"], job["error"], rc = "failed", str(e), 1
        r.log("FAILED: %s" % e)
    job["rc"], job["finished"] = rc, time.strftime("%Y-%m-%dT%H:%M:%S%z")
    save()
    return rc

def job_exec(name):
    os.makedirs(JOB_DIR, mode=0o700, exist_ok=True)
    stp, logp = os.path.join(JOB_DIR, name + ".json"), os.path.join(JOB_DIR, name + ".log")
    started = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    json.dump({"state": "running", "started": started}, open(stp, "w"))
    open(logp, "w").close()
    log("job %s started" % name)
    if name == "setup-install":
        rc = setup_install(logp, stp, started)
    elif name == "upgrade-crowdsec":
        rc = staged(logp, stp, started, se.crowdsec_upgrade)
    elif name == "upgrade-cowsec":
        rc = staged(logp, stp, started, se.cowsec_self_update)
    elif name == "mailcow-update":
        opts = se.validate_update_options(json.load(open(se.MAILCOW_UPDATE_OPTIONS)))
        rc = staged(logp, stp, started, lambda r, progress: se.mailcow_update(r, progress, opts))
    elif name == "mailcow-check":
        rc = staged(logp, stp, started, lambda r, progress: (progress(None, "plan", [{"id": "check", "title": "Ask mailcow for updates"}]),
                                                              progress("check", "running"), se.mailcow_check(r), progress("check", "ok")))
    else:
        with open(logp, "w") as lf:
            p = subprocess.run(["bash", "-c", JOBS[name]], stdout=lf, stderr=subprocess.STDOUT, timeout=1800)
        rc = p.returncode
        json.dump({"state": "ok" if rc == 0 else "failed", "rc": rc, "started": started,
                   "finished": time.strftime("%Y-%m-%dT%H:%M:%S%z")}, open(stp, "w"))
    log("job %s finished rc=%d" % (name, rc))

def apt_versions(name):
    rc, out, _ = run(["apt-cache", "policy", name])
    inst = re.search(r"Installed:\s*(\S+)", out)
    cand = re.search(r"Candidate:\s*(\S+)", out)
    i = inst.group(1) if inst and inst.group(1) != "(none)" else None
    c = cand.group(1) if cand and cand.group(1) != "(none)" else None
    return {"name": name, "installed": i, "candidate": c, "upgradable": bool(i and c and i != c), "managed": name in UPGRADABLE}

def mtime(path):
    try:
        return time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(os.path.getmtime(path)))
    except Exception:
        return None

def updates():
    hub = jcmd(["cscli", "hub", "list", "-o", "json"], {}) or {}
    counts, pending, tainted = {}, [], []
    for kind, items in hub.items():
        counts[kind] = len(items or [])
        for it in items or []:
            st = it.get("status", "")
            if "update" in st:
                pending.append({"type": kind, "name": it.get("name"), "version": it.get("local_version")})
            if "tainted" in st:
                tainted.append({"type": kind, "name": it.get("name")})
    rc, out, _ = run(["systemctl", "show", "crowdsec-hubupdate.timer", "-p", "UnitFileState,ActiveState,LastTriggerUSec,NextElapseUSecRealtime"])
    t = dict(l.split("=", 1) for l in out.splitlines() if "=" in l)
    rc, res, _ = run(["systemctl", "show", "crowdsec-hubupdate.service", "-p", "Result"])
    return {
        "packages": [apt_versions(n) for n in PACKAGES],
        "aptListsUpdated": mtime("/var/cache/apt/pkgcache.bin"),  # rebuilt by every apt-get update
        "hub": {"counts": counts, "pending": pending, "tainted": tainted, "indexUpdated": mtime(CS_DIR + "/hub/.index.json")},
        "hubAutoUpdate": {"enabled": t.get("UnitFileState") == "enabled", "active": t.get("ActiveState") == "active",
                          "last": t.get("LastTriggerUSec") or None, "next": t.get("NextElapseUSecRealtime") or None,
                          "lastResult": res.strip().partition("=")[2] or None},
        "jobs": {n: job_state(n) for n in JOBS if n != "setup-install"},
        "mailcow": se.mailcow_update_status(),
    }

def b64arg(a):
    import base64
    return base64.urlsafe_b64decode(a + "=" * (-len(a) % 4)).decode()

def main():
    cmd = os.environ.get("SSH_ORIGINAL_COMMAND", "").split()
    if not cmd:
        print("no command", file=sys.stderr); sys.exit(2)
    verb, args = cmd[0], cmd[1:]
    peer = os.environ.get("SSH_CLIENT", "?").split()[0]
    if verb == "status" and not args:
        print(json.dumps(status())); return
    try:
        if verb == "policy-get" and not args:
            print(json.dumps(policy_get())); return
        if verb == "policy-apply" and not args:
            log("%s policy-apply" % peer)
            print(json.dumps(policy_apply())); return
        if verb == "auth-failures" and not args:
            print(json.dumps(auth_failures())); return
        if verb == "updates" and not args:
            print(json.dumps(updates())); return
        if verb == "job" and len(args) == 1 and args[0] in JOBS:
            log("%s job %s" % (peer, args[0]))
            print(json.dumps(job_start(args[0]))); return
        if verb == "job-exec" and len(args) == 1 and args[0] in JOBS and os.environ.get("INVOCATION_ID"):
            job_exec(args[0]); return
        if verb == "job-state" and len(args) == 1 and args[0] in JOBS:
            print(json.dumps(job_state(args[0]))); return
        if verb == "setup-check" and not args:
            print(json.dumps(se.preflight())); return
        if verb == "dns-providers" and not args:
            print(json.dumps({"providers": se.dns_providers(), "lego": se.LEGO_VERSION})); return
        if verb == "dns-help" and len(args) == 1:
            print(json.dumps(se.dns_provider_help(args[0]))); return
        if verb == "mailcow-containers" and not args:
            print(json.dumps(se.mailcow_containers())); return
        if verb == "fs-list" and len(args) == 1:
            print(json.dumps(se.fs_list(b64arg(args[0])))); return
        if verb == "fs-mkdir" and len(args) == 1:
            print(json.dumps(se.fs_mkdir(b64arg(args[0])))); return
        if verb == "mailcow-update-options" and len(args) == 1:
            o = se.validate_update_options(json.loads(b64arg(args[0])))
            se.write(se.MAILCOW_UPDATE_OPTIONS, json.dumps(o) + "\n", 0o600)
            print(json.dumps(o)); return
        if verb == "mailcow-da-acl" and not args:
            print(json.dumps(se.mailcow_da_acl())); return
        if verb == "netfilter-state" and not args:
            print(json.dumps(se.netfilter_state())); return
        if verb == "netfilter-coordinate" and len(args) == 2 and args[1] in ("0", "1"):
            log("%s netfilter-coordinate %s" % (peer, args[0]))
            print(json.dumps(se.netfilter_coordinate(args[0], args[1] == "1", se.Runner(echo=False)))); return
        if verb == "cowsec-release" and len(args) <= 1:
            print(json.dumps(se.cowsec_release_status(force=args == ["refresh"]))); return
        if verb == "cowsec-update-source" and not args:
            o = json.loads(sys.stdin.read(16384) or "{}")
            log("%s cowsec-update-source repo=%s token=%s" % (peer, o.get("repo"), "set" if o.get("token") else ("cleared" if o.get("clearToken") else "unchanged")))
            print(json.dumps(se.set_update_source(o.get("repo"), o.get("token"), bool(o.get("clearToken"))))); return
        if verb == "netfilter-sync" and not args:
            print(json.dumps(se.netfilter_sync())); return
        if verb == "certs-renew" and not args:
            se.certs_renew(se.Runner(echo=True)); return
    except (ValueError, RuntimeError, se.StepError) as ex:
        print(str(ex), file=sys.stderr); sys.exit(4)
    if verb == "action" and len(args) == 1 and args[0] in ACTIONS:
        log("%s action %s" % (peer, args[0]))
        for c in ACTIONS[args[0]]:
            rc, out, err = run(c, timeout=120)
            if rc != 0:
                sys.stderr.write(err or out); sys.exit(rc)
        print("%s: done" % args[0]); return
    print("command not allowed", file=sys.stderr); sys.exit(3)

if __name__ == "__main__":
    main()
