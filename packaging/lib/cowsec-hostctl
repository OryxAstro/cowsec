#!/usr/bin/env python3
"""CowSec host helper: the only part of CowSec that touches system services and files.

The CowSec server (running as root under systemd) calls it with the verb in
SSH_ORIGINAL_COMMAND; every verb is allowlisted below and none runs arbitrary commands.
  status                 JSON health report (services, bouncers, AppSec, acquisition, TLS, clock)
  action <name>          one allowlisted service action
  policy-get             ban policy + repeat-offender stats
  policy-apply           render policy.pending.json (or policy.json) into CrowdSec, test, reload
  auth-failures          failed SMTP AUTH / IMAP-POP logins per IP over the last 24h
  updates                package, hub and auto-update status, plus background job state
  job <name>             start a background job (apt-refresh, upgrade-crowdsec, hub-upgrade, setup-install)
  setup-check            pre-flight checks for the setup wizard
  dns-providers          DNS-01 providers supported by lego
  dns-help <code>        credentials a DNS provider needs
  certs-renew            renew DNS-01 certificates (timer)
"""
