def log(msg):
    syslog.openlog("cowsec-hostctl"); syslog.syslog(syslog.LOG_INFO, msg)

def run(cmd, timeout=60):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except Exception as e:
        return 1, "", str(e)

def jcmd(cmd, default=None):
    rc, out, _ = run(cmd)
    if rc != 0:
        return default
    try:
        return json.loads(out)
    except Exception:
        return default

def svc(name):
    rc, out, _ = run(["systemctl", "show", name, "-p", "ActiveState,SubState,ActiveEnterTimestamp,NRestarts"])
    d = dict(l.split("=", 1) for l in out.splitlines() if "=" in l)
    return {"name": name, "state": d.get("ActiveState", "unknown"), "sub": d.get("SubState", ""),
            "since": d.get("ActiveEnterTimestamp", ""), "restarts": d.get("NRestarts", "")}

def pkg(name):
    rc, out, _ = run(["dpkg-query", "-W", "-f=${Version}", name])
    return out.strip() if rc == 0 else None

def cert(path):
    rc, out, _ = run(["openssl", "x509", "-in", path, "-noout", "-enddate", "-issuer", "-ext", "subjectAltName"])
    if rc != 0:
        return None
    end = re.search(r"notAfter=(.+)", out)
    names = re.findall(r"DNS:([^,\s]+)", out)
    issuer = re.search(r"CN ?= ?([^,\n]+)", out.split("issuer=")[-1]) if "issuer=" in out else None
    exp = None
    if end:
        try: exp = time.mktime(time.strptime(end.group(1).strip(), "%b %d %H:%M:%S %Y %Z"))
        except Exception: pass
    return {"notAfter": end.group(1).strip() if end else None, "daysLeft": int((exp - time.time()) / 86400) if exp else None,
            "issuer": issuer.group(1).strip() if issuer else None, "names": names}

def firewall():
    out = {"ipsets": {}, "iptablesRules": 0}
    if shutil.which("ipset"):
        rc, o, _ = run(["ipset", "list", "-n"])
        for n in o.split():
            if "crowdsec" in n.lower():
                rc2, o2, _ = run(["ipset", "list", n])
                m = re.search(r"Number of entries: (\d+)", o2)
                out["ipsets"][n] = int(m.group(1)) if m else None
    rc, o, _ = run(["iptables", "-S"])
    out["iptablesRules"] = sum(1 for l in o.splitlines() if "CROWDSEC" in l.upper())
    if shutil.which("nft"):  # nftables bouncer: sets live in its own tables
        for fam in ("ip", "ip6"):
            rc, o, _ = run(["nft", "-j", "list", "table", fam, "crowdsec" if fam == "ip" else "crowdsec6"])
            if rc != 0:
                continue
            try:
                for it in json.loads(o).get("nftables", []):
                    st = it.get("set")
                    if st:
                        out["ipsets"]["%s %s" % (fam, st["name"])] = len(st.get("elem", []))
                    elif it.get("rule"):
                        out["iptablesRules"] += 1
            except ValueError:
                pass
    return out

def unit_exists(name):
    rc, out, _ = run(["systemctl", "show", name, "-p", "LoadState", "--value"])
    return out.strip() == "loaded"

def main_cert_path():
    certs = os.path.join(se.ETC_DIR, "certs.json")
    if os.path.exists(certs):
        for name in ("mailcow-host", "mailcow"):
            p = os.path.join(se.CERT_DIR, name, "fullchain.pem")
            if os.path.exists(p):
                return p
        found = sorted(glob_files(os.path.join(se.CERT_DIR, "*", "fullchain.pem")))
        if found:
            return found[0]
    mc = se.find_mailcow()
    return os.path.join(mc, "data/assets/ssl/cert.pem") if mc else None

def glob_files(pattern):
    import glob
    return glob.glob(pattern)

def status():
    rc, uptime, _ = run(["uptime", "-p"])
    load = os.getloadavg()
    rc, chrony, _ = run(["chronyc", "-c", "tracking"])
    ct = chrony.strip().split(",") if rc == 0 else []
    mc = se.mailcow_info()
    containers = list((mc.get("containers") or {}).values())
    realip = se.NGX + "/conf.d/cloudflare_realip.conf"
    realip_info = None
    if os.path.exists(realip):
        txt = open(realip).read()
        realip_info = {"ranges": txt.count("set_real_ip_from"), "updated": time.strftime("%Y-%m-%d", time.localtime(os.path.getmtime(realip)))}
    bconf = "/etc/crowdsec/bouncers/crowdsec-openresty-bouncer.conf"
    appsec_cfg = {}
    if os.path.exists(bconf):
        for l in open(bconf):
            k, _, v = l.strip().partition("=")
            if k in ("MODE", "APPSEC_URL", "APPSEC_FAILURE_ACTION", "ALWAYS_SEND_TO_APPSEC", "BOUNCING_ON_TYPE", "FALLBACK_REMEDIATION"):
                appsec_cfg[k] = v
    rc, ss, _ = run(["ss", "-ltnH"])
    listening = lambda port: any(re.search(r"[:.]%d\s" % port, l + " ") for l in ss.splitlines())
    rc, ver, _ = run(["cscli", "version"])
    m = re.search(r"version:\s*(\S+)", ver)
    services = [s for s in ("crowdsec", "crowdsec-firewall-bouncer", "openresty", "chrony", "cloudflared", "cowsec") if unit_exists(s + ".service")]
    timers = [t for t in ("crowdsec-hubupdate.timer", "cowsec-certs.timer", "cowsec-cert-watch.path", "cowsec-cloudflare-realip.timer") if unit_exists(t)]
    setup = {}
    if os.path.exists(os.path.join(STATE_DIR, "setup.json")):
        try:
            setup = json.load(open(os.path.join(STATE_DIR, "setup.json")))
        except Exception:
            setup = {}
    return {
        "host": socket.gethostname(), "uptime": uptime.strip(), "load": [round(x, 2) for x in load],
        "time": {"source": ct[1] if len(ct) > 1 else None, "offsetSeconds": float(ct[4]) if len(ct) > 4 else None,
                 "stratum": ct[2] if len(ct) > 2 else None},
        "crowdsecVersion": m.group(1) if m else None,
        "packages": {p: pkg(p) for p in PACKAGES},
        "services": [svc(s) for s in services],
        "timers": [svc(t) for t in timers],
        "appsec": {"listening": listening(7422), "config": appsec_cfg,
                   "metrics": jcmd(["cscli", "metrics", "show", "appsec", "-o", "json"], {})},
        "lapi": {"listening": listening(8080)},
        "acquisition": jcmd(["cscli", "metrics", "show", "acquisition", "-o", "json"], {}),
        "bouncerMetrics": jcmd(["cscli", "metrics", "show", "bouncers", "-o", "json"], {}),
        "firewall": firewall(),
        "certificate": cert(main_cert_path()) if main_cert_path() else None,
        "cloudflareRealIP": realip_info,
        "mailcow": {"hostname": mc.get("hostname"), "dir": mc.get("dir"), "domains": len(mc.get("domains", []))},
        "mailcowContainers": {"running": sum(1 for c in containers if c["status"].startswith("Up")), "total": len(containers),
                               "unhealthy": [c["name"] for c in containers if "unhealthy" in c["status"] or not c["status"].startswith("Up")]},
        "setup": {"accessMode": (setup.get("access") or {}).get("mode"), "edge": (setup.get("components") or {}).get("edge"),
                  "certMode": (setup.get("certs") or {}).get("mode")},
    }

# ---------- ban policy ----------

def flush_max_age_days():
    try:
        m = re.search(r"^\s*flush:.*?^\s*max_age:\s*(\d+)([dh])", open(CS_DIR + "/config.yaml").read(), re.S | re.M)
        if m:
            return max(1, int(m.group(1)) // (24 if m.group(2) == "h" else 1))
    except Exception:
        pass
    return 7

def validate_policy(p):
    """Returns a clean policy or raises ValueError. Mirrors the checks in the CowSec server."""
    if not isinstance(p, dict):
        raise ValueError("policy must be an object")
    cc = p.get("homeCountries")
    if not isinstance(cc, list) or not 1 <= len(cc) <= 30 or not all(isinstance(c, str) and re.fullmatch(r"[A-Z]{2}", c) for c in cc):
        raise ValueError("homeCountries must be 1-30 ISO 3166 alpha-2 codes")
    a, e = p.get("abroad") or {}, p.get("escalation") or {}
    def num(d, k, lo, hi):
        v = d.get(k)
        if not isinstance(v, int) or isinstance(v, bool) or not lo <= v <= hi:
            raise ValueError("%s must be a whole number from %d to %d" % (k, lo, hi))
        return v
    def flag(d, k):
        if not isinstance(d.get(k), bool):
            raise ValueError("%s must be true or false" % k)
        return d[k]
    clean = {
        "homeCountries": sorted(set(cc)),
        "abroad": {"enabled": flag(a, "enabled"), "smtp": flag(a, "smtp"), "imap": flag(a, "imap"),
                   "failures": num(a, "failures", 1, 20), "windowHours": num(a, "windowHours", 1, 168)},
        "escalation": {"enabled": flag(e, "enabled"), "includeHome": bool(e.get("includeHome", False) is True),
                       "baseHours": num(e, "baseHours", 1, 168),
                       "mode": e.get("mode") if e.get("mode") in ("linear", "double") else None,
                       "maxHours": num(e, "maxHours", 1, 720), "lookbackDays": num(e, "lookbackDays", 1, 30)},
    }
    if clean["escalation"]["mode"] is None:
        raise ValueError("mode must be linear or double")
    if clean["escalation"]["maxHours"] < clean["escalation"]["baseHours"]:
        raise ValueError("maxHours must be at least baseHours")
    if clean["escalation"]["lookbackDays"] > flush_max_age_days():
        raise ValueError("lookbackDays cannot exceed CrowdSec's history (%d days, db_config.flush.max_age)" % flush_max_age_days())
    if clean["abroad"]["enabled"] and not (clean["abroad"]["smtp"] or clean["abroad"]["imap"]):
        raise ValueError("choose SMTP and/or IMAP/POP for the abroad rule")
    return clean

def load_policy():
    try:
        return validate_policy(json.load(open(os.path.join(STATE_DIR, "policy.json"))))
    except Exception:
        return json.loads(json.dumps(DEFAULT_POLICY))

def ladder(e):
    """Ban duration (hours) for 0, 1, 2... previous bans, ending at the cap."""
    out, k = [], 0
    while True:
        h = e["baseHours"] * (k + 1) if e["mode"] == "linear" else e["baseHours"] * (2 ** k)
        out.append(min(h, e["maxHours"]))
        if h >= e["maxHours"] or len(out) >= 12:
            return out
        k += 1

def existing_notifications():
    try:
        txt = open(PROFILES).read()
        m = re.search(r"^notifications:\s*\n((?:\s*-\s*\S+\s*\n)+)", txt, re.M)
        return re.findall(r"-\s*(\S+)", m.group(1)) if m else []
    except Exception:
        return []

def render_profiles(p, notifications):
    e = p["escalation"]
    base = 'Alert.Remediation == true && Alert.GetScope() == "Ip"'
    notif = "".join(" - %s\n" % n for n in notifications)
    def profile(name, flt, hours):
        return ("name: %s\nfilters:\n - %s\ndecisions:\n - type: ban\n   duration: %dh\n%son_success: break\n"
                % (name, flt, hours, ("notifications:\n" + notif) if notif else ""))
    docs = []
    if e["enabled"]:
        steps = ladder(e)
        since = "%dh" % (e["lookbackDays"] * 24)
        # Home-country IPs keep the first-ban length unless includeHome is set: a mail client
        # with a stale saved password at a customer's house should not earn a week-long ban.
        home = "" if e["includeHome"] else " && !(Alert.Source.Cn in [%s])" % ", ".join("'%s'" % c for c in p["homeCountries"])
        for k in range(len(steps) - 1, 0, -1):
            docs.append(profile("cowsec_repeat_offender_%d" % k,
                                '%s%s && GetDecisionsSinceCount(Alert.GetValue(), "%s") >= %d' % (base, home, since, k), steps[k]))
        docs.append(profile("default_ip_remediation", base, steps[0]))
    else:
        docs.append(profile("default_ip_remediation", base, e["baseHours"]))
    docs.append(profile("default_range_remediation", 'Alert.Remediation == true && Alert.GetScope() == "Range"', e["baseHours"]))
    head = ("# Managed by CowSec (Ban policy). Changes made here are replaced on the next apply;\n"
            "# the original file is kept as profiles.yaml.pre-cowsec.\n")
    return head + "---\n".join(docs)

def render_abroad(p):
    a = p["abroad"]
    if not a["enabled"]:
        return None
    parts = []
    if a["smtp"]:
        parts.append("(evt.Meta.log_type_enh == 'spam-attempt' && evt.Meta.service == 'postfix')")
    if a["imap"]:
        parts.append("(evt.Meta.log_type == 'dovecot_logs' && evt.Meta.dovecot_login_result == 'auth_failed')")
    home = ", ".join("'%s'" % c for c in p["homeCountries"])
    flt = "(%s) && evt.Enriched.IsoCode != '' && !(evt.Enriched.IsoCode in [%s])" % (" || ".join(parts), home)
    n, w = a["failures"], a["windowHours"]
    if n == 1:
        bucket = "type: trigger\n"
    else:
        bucket = "type: leaky\ncapacity: %d\nleakspeed: \"%dm\"\n" % (n - 1, max(1, w * 60 // (n - 1)))
    return ("# Managed by CowSec (Ban policy): failed mail logins from outside %s.\n"
            "%sname: cowsec/auth-abroad\n"
            "description: \"%d failed mail login(s) within about %dh from outside the home countries\"\n"
            "filter: \"%s\"\n"
            "groupby: evt.Meta.source_ip\nblackhole: 1m\n"
            "labels:\n  service: mail\n  behavior: \"generic:bruteforce\"\n  label: \"Mail login brute force from abroad\"\n"
            "  confidence: 2\n  spoofable: 0\n  remediation: true\n"
            % (", ".join(p["homeCountries"]), bucket, n, w, flt.replace('"', '\\"')))

def write_atomic(path, text):
    tmp = path + ".cowsec-tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)

def policy_apply():
    pending, saved = os.path.join(STATE_DIR, "policy.pending.json"), os.path.join(STATE_DIR, "policy.json")
    src = pending if os.path.exists(pending) else saved
    try:
        p = validate_policy(json.load(open(src)))
        res = apply_policy(p)
    except Exception:
        if src == pending:
            os.remove(pending)
        raise
    if src == pending:
        os.replace(pending, saved)
    return res

def apply_policy(p):
    if not os.path.exists(PROFILES + ".pre-cowsec"):
        shutil.copy2(PROFILES, PROFILES + ".pre-cowsec")
    old = {f: (open(f).read() if os.path.exists(f) else None) for f in (PROFILES, ABROAD_SCENARIO)}
    notifications = existing_notifications()
    write_atomic(PROFILES, render_profiles(p, notifications))
    abroad = render_abroad(p)
    if abroad:
        write_atomic(ABROAD_SCENARIO, abroad)
    elif os.path.exists(ABROAD_SCENARIO):
        os.remove(ABROAD_SCENARIO)
    rc, out, err = run(["crowdsec", "-c", CS_DIR + "/config.yaml", "-t"], timeout=120)
    if rc != 0:
        for f, txt in old.items():
            if txt is None:
                if os.path.exists(f): os.remove(f)
            else:
                write_atomic(f, txt)
        raise RuntimeError("CrowdSec rejected the new policy, previous files restored: " + (err or out).strip()[-400:])
    rc, out, err = run(["systemctl", "reload", "crowdsec"], timeout=120)
    if rc != 0:
        raise RuntimeError("policy written but reload failed: " + (err or out).strip())
    log("policy applied: home=%s abroad=%s escalation=%s" % (",".join(p["homeCountries"]), p["abroad"]["enabled"], p["escalation"]["enabled"]))
    return {"applied": True, "ladderHours": ladder(p["escalation"]) if p["escalation"]["enabled"] else [p["escalation"]["baseHours"]],
            "notifications": notifications}

def repeat_offenders(days):
    try:
        db = sqlite3.connect("file:%s?mode=ro" % CS_DB, uri=True, timeout=5)
        since = (datetime.datetime.utcnow() - datetime.timedelta(days=days)).strftime("%Y-%m-%d %H:%M:%S")
        rows = db.execute("select value, count(*) n, max(created_at) from decisions where origin = 'crowdsec' and scope = 'Ip' "
                          "and created_at >= ? group by value order by n desc", (since,)).fetchall()
        buckets = {"1": 0, "2": 0, "3-5": 0, "6+": 0}
        for _, n, _ in rows:
            buckets["1" if n == 1 else "2" if n == 2 else "3-5" if n <= 5 else "6+"] += 1
        return {"days": days, "ips": len(rows), "histogram": buckets,
                "top": [{"ip": v, "bans": n, "last": str(t)[:19]} for v, n, t in rows[:15]]}
    except Exception as ex:
        return {"days": days, "error": str(ex)}

def policy_get():
    p = load_policy()
    managed = os.path.exists(PROFILES) and "Managed by CowSec" in open(PROFILES).read()
    return {"policy": p, "saved": os.path.exists(os.path.join(STATE_DIR, "policy.json")), "managed": managed,
            "abroadScenarioInstalled": os.path.exists(ABROAD_SCENARIO), "historyDays": flush_max_age_days(),
            "notifications": existing_notifications(), "repeatOffenders": repeat_offenders(min(flush_max_age_days(), 7))}

# ---------- failed mail logins ----------

def container(service):
    return ((se.mailcow_info().get("containers") or {}).get(service) or {}).get("name")

def auth_failures():
    res = {"hours": 24, "smtp": {}, "imap": {}}
    info = se.mailcow_info().get("containers") or {}
    pc, dc = (info.get("postfix-mailcow") or {}).get("name"), (info.get("dovecot-mailcow") or {}).get("name")
    if pc:
        rc, out, err = run(["docker", "logs", "--since", "24h", pc], timeout=120)
        for m in re.finditer(r"\[([0-9a-fA-F.:]+)\]: SASL \S+ authentication failed", out + err):
            res["smtp"][m.group(1)] = res["smtp"].get(m.group(1), 0) + 1
    if dc:
        rc, out, err = run(["docker", "logs", "--since", "24h", dc], timeout=120)
        for m in re.finditer(r"auth failed, (\d+) attempts?.*?rip=([0-9a-fA-F.:]+)", out + err):
            res["imap"][m.group(2)] = res["imap"].get(m.group(2), 0) + int(m.group(1))
    return res

